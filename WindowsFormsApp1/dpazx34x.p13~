            if (!string.IsNullOrWhiteSpace(sinifAdi))
            {
                if (!hedef.SinifAdlari.Contains($"'{sinifAdi}'"))
                {
                    if (string.IsNullOrEmpty(hedef.SinifAdlari))
                        hedef.SinifAdlari = $"{{'{sinifAdi}'}}";
                    else
                        hedef.SinifAdlari = hedef.SinifAdlari.TrimEnd('}') + $",'{sinifAdi}'}}";

                    settingsSiniflarList_listbox.Items.Add(sinifAdi);
                    ConnectToDatabase.SaveChanges();
                    settingsDegisiklikYapiildimi = true;
                    MessageBox.Show("Sınıf ismi başarıyla eklendi.");
                }
                else
                {
                    MessageBox.Show("Bu sınıf zaten mevcut!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            else
            {
                MessageBox.Show("Sınıf adı boş bırakılamaz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }
        private void settingsTumIllerOzelIllerDuzenleButon_button_Click(object sender, EventArgs e)
        {
            // Eğer "Özel İller" seçili ise
            if (settingsOzelIller_radio.Checked)
            {
                // Seçilen ili alın
                string seciliIl = settingsOzelIller_combo.SelectedItem as string;

                // Eğer herhangi bir il seçildiyse
                if (!string.IsNullOrEmpty(seciliIl))
                {
                    // Veritabanındaki ilgili alanı güncelle
                    var settings = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
                    if (settings != null)
                    {
                        // Mevcut illeri al
                        var mevcutIller = new List<string>();
                        if (!string.IsNullOrEmpty(settings.FirmIslemleriSayfasındaListelenecekIller))
                        {
                            mevcutIller = settings.FirmIslemleriSayfasındaListelenecekIller
                                .Trim('{', '}') // Süslü parantezleri temizle
                                .Split(',')
                                .Select(il => il.Trim('\'', ' ')) // Tırnak işaretlerini ve boşlukları temizle
                                .ToList();
                        }

                        // Eğer "Tüm İller" mevcutsa, onu listeden kaldır
                        if (mevcutIller.Contains("Tüm İller"))
                        {
                            mevcutIller.Remove("Tüm İller");
                        }

                        // Eğer seçili il daha önce eklenmemişse listeye ekle
                        if (!mevcutIller.Contains(seciliIl))
                        {
                            mevcutIller.Add(seciliIl);
                        }

                        // Yeni listeyi string olarak formatla ve veritabanına kaydet
                        settings.FirmIslemleriSayfasındaListelenecekIller = $"{{{string.Join(",", mevcutIller.Select(il => $"'{il}'"))}}}";
                        ConnectToDatabase.SaveChanges();
                        settingsDegisiklikYapiildimi = true;
                        // Mevcut illeri MessageBox ile göster
                        MessageBox.Show($"Mevcut İller: {string.Join(", ", mevcutIller)}", "Bilgilendirme", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                }
            }
            else if (settingsTumIller_radio.Checked)
            {
                // "Tüm İller" seçili olduğunda
                var settings = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
                if (settings != null)
                {
                    settings.FirmIslemleriSayfasındaListelenecekIller = "Tüm İller";
                    ConnectToDatabase.SaveChanges();
                }
            }
        }

