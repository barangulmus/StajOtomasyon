        private void settingsAlanDaliEkleButon_button_Click(object sender, EventArgs e)
        {
            var hedef = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
            string alanAdi = settingsAlanAdi_textbox.Text;
            string dalAdi = settingsAlanaAitDalAdi_textbox.Text;

            if (!string.IsNullOrWhiteSpace(alanAdi) && !string.IsNullOrWhiteSpace(dalAdi))
            {
                string yeniDal = $"{alanAdi}-/-{dalAdi}";
