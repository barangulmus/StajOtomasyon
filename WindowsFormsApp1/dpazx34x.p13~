        private void addOgrenciEkle_button_Click(object sender, EventArgs e)
        {
            // Her ComboBox için AYRI AYRI kontrol yapılıyor
            bool isValid = true;

            // 1. Sınıf Kontrolü
            if (!ComboBoxKontrol(addOgrenciSinifi_combo, "Lütfen geçerli bir sınıf seçin!"))
                isValid = false;

            // 2. Firma Kontrolü (TEK SEFERDE)
            if (!ComboBoxKontrol(addOgrenciFirmaAdi_combo, "Lütfen geçerli bir firma seçin!"))
                isValid = false;

            // 3. Alan Adı Kontrolü
            if (!ComboBoxKontrol(addOgrenciAlanAdi_txt, "Lütfen geçerli bir alan adı seçin!"))
                isValid = false;

            // 4. Dal Adı Kontrolü
            if (!ComboBoxKontrol(addOgrenciDalAdi_combo, "Lütfen geçerli bir dal seçin!"))
                isValid = false;

            // 5. Koordinatör Öğretmen Kontrolü
            if (!ComboBoxKontrol(addOgrenciKordinatorOgretmen_combo, "Lütfen geçerli bir koordinatör öğretmen seçin!"))
                isValid = false;

            // Eğer herhangi biri geçersizse işlemi durdur
            if (!isValid) return;

            // 2. Alan Adı için Özel Kontrol (TextBox mı ComboBox mı?)
            if (string.IsNullOrWhiteSpace(addOgrenciAlanAdi_txt.Text))
            {
                MessageBox.Show("Alan adı boş olamaz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // 3. Staj Dönemi Kontrolü
            if (StajDonemi == null)
            {
                MessageBox.Show("Lütfen sol menüden staj dönemi seçiniz!");
                return;
            }

            // 4. RadioButton Kontrolü
            if (!addOgrGrupA_radio.Checked && !addOgrGrupB_radio.Checked &&
                !addOgrGrupC_radio.Checked && !addOgrGrupD_radio.Checked)
            {
                MessageBox.Show("Lütfen öğrenci grubu seçiniz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            try
            {
                // 5. Nesne Atamaları (Null Check Eklenmiş Hali)
                csOgrenciClass.OgrenciAd = addOgrenciAdi_txt.Text;
                csOgrenciClass.OgrenciSoyad = addOgrenciSoyadi_txt.Text;
                csOgrenciClass.OgrenciOkulNo = addOgrenciNo_txt.Text;
                csOgrenciClass.OgrenciSinif = addOgrenciSinifi_combo.SelectedItem?.ToString() ?? "";
                csOgrenciClass.OgrencininFirmaAdi = addOgrenciFirmaAdi_combo.SelectedItem?.ToString() ?? "";
                csOgrenciClass.OgrenciKoordinatorOgretmeni = addOgrenciKordinatorOgretmen_combo.SelectedItem?.ToString() ?? "";
                csOgrenciClass.OgreciTelNo = addOgrenciTelNo_txt.Text;
                csOgrenciClass.OgrenciTCKimlikNo = addOgrenciTc_txt.Text;
                csOgrenciClass.OgrenciAlanAdi = addOgrenciAlanAdi_txt.Text; // TextBox ise Text alınır
                csOgrenciClass.OgrenciDalAdi = addOgrenciDalAdi_combo.SelectedItem?.ToString() ?? "";
                csOgrenciClass.OgrenciStajDonemi = StajDonemi;

                // 6. RadioButton Ataması
                csOgrenciClass.OgrenciGrup = addOgrGrupA_radio.Checked ? "A" :
                                            addOgrGrupB_radio.Checked ? "B" :
                                            addOgrGrupC_radio.Checked ? "C" : "D";

                // 7. Tarih Kontrolleri
                if (addOgrenciStajBaslangic_datetime.Value > addOgrenciStajBitis_datetime.Value)
                {
                    MessageBox.Show("Başlangıç tarihi bitiş tarihinden sonra olamaz!");
                    return;
                }
                csOgrenciClass.OgrenciStajaBaslangicTarihi = addOgrenciStajBaslangic_datetime.Value;
                csOgrenciClass.OgrenciStajBitistarihi = addOgrenciStajBitis_datetime.Value;

                // 8. Öğrenci Var Mı Kontrolü
                var ogrenciVarMi = ConnectToDatabase.OgrenciTablo
                    .Any(o => o.OgrenciOkulNo == csOgrenciClass.OgrenciOkulNo);

                if (ogrenciVarMi)
                {
                    MessageBox.Show("Bu okul numarasına sahip bir öğrenci zaten var.");
                    return;
                }

                //////////////////////////////////////////////////////////
                if (string.IsNullOrEmpty(selectedImagePath))
                {
                    MessageBox.Show("Önce bir fotoğraf seçmelisiniz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                string saveDirectory = System.IO.Path.Combine(Application.StartupPath, "Fotograflar", "OgrenciFotograflari");
                Directory.CreateDirectory(saveDirectory);

                string savePath = System.IO.Path.Combine(saveDirectory, addOgrenciNo_txt.Text + ".jpg");
                File.Copy(selectedImagePath, savePath, true);

                MessageBox.Show("Fotoğraf başarıyla kaydedildi!", "Başarılı", MessageBoxButtons.OK, MessageBoxIcon.Information);
                //////////////////////////////////////////////////////////
                // 9. Veritabanına Ekleme
                ConnectToDatabase.OgrenciTablo.Add(csOgrenciClass);
                ConnectToDatabase.SaveChanges();
                MessageBox.Show("Öğrenci başarıyla eklendi.");
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Hata: {ex.Message}");
            }
            finally
            {
                IslemSonrasiSayfaDuzeni();
                addOgrenciTemizle();
            }
        }
