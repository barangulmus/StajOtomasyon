                {
                    if (string.IsNullOrEmpty(hedef.AlanaAitDalAdlari))
                        hedef.AlanaAitDalAdlari = $"{{'{yeniDal}'}}";
                    else
                        hedef.AlanaAitDalAdlari = hedef.AlanaAitDalAdlari.TrimEnd('}') + $",'{yeniDal}'}}";

