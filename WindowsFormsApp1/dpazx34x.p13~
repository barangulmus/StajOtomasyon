        // Günleri sayısal değerlere dönüştüren bir yardımcı fonksiyon
        private int GetDayNumber(string day)
        {
            switch (day)
            {
                case "Pazartesi": return 1;
                case "Salı": return 2;
                case "Çarşamba": return 3;
                case "Perşembe": return 4;
                case "Cuma": return 5;
                case "Cumartesi": return 6;
                case "Pazar": return 7;
                default: return 0; // Geçersiz bir değer
            }
        }
