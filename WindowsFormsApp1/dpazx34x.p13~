                                ws.Cell("K15").Value = $"Kaşe-İmza{Environment.NewLine}{Xisletme.IsletmeYetkilisi}{Environment.NewLine}İşletme Yetkilisi";
                                ws.Cell("Q15").Value = $"İmza{Environment.NewLine} {Xayarlar.okulMuduruIsmi} {Environment.NewLine}Okul Müdürü";
                                ws.Cell("T15").Value = $"İmza{Environment.NewLine} {Xayarlar.MudurYardimcisiAdi} {Environment.NewLine}Müdür Yardımcısı";


                                // Değişiklikleri kaydet
                                workbook.Save();
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show("Bir hata oluştu: " + ex.Message, "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                    finally
                    {
                        Excel.Application excelApp = null;
                        Excel.Workbook workbook = null;
                        Excel.Worksheet worksheet = null;

                        try
                        {
                            // Excel uygulamasını başlat
                            excelApp = new Excel.Application();
                            workbook = excelApp.Workbooks.Open(dosyaYolu);
                            worksheet = workbook.Worksheets[YazdirilacakBelge];

                            //ilk ve son sayfaları gizle
                            if (YazdirilacakBelge == "Aylik_Gunluk")
                            {
                                workbook.Sheets[1].Visible = Excel.XlSheetVisibility.xlSheetVisible;
                                workbook.Sheets[2].visible = Excel.XlSheetVisibility.xlSheetHidden;
                                workbook.Sheets[3].Visible = Excel.XlSheetVisibility.xlSheetHidden;
                                worksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlPortrait;
                            }
                            if (YazdirilacakBelge == "Devamsizlik")
                            {
                                workbook.Sheets[1].Visible = Excel.XlSheetVisibility.xlSheetHidden;
                                workbook.Sheets[2].visible = Excel.XlSheetVisibility.xlSheetVisible;
                                workbook.Sheets[3].Visible = Excel.XlSheetVisibility.xlSheetHidden;
                                worksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlLandscape;
                            }
                            if (YazdirilacakBelge == "NotFisi")
                            {
                                workbook.Sheets[1].Visible = Excel.XlSheetVisibility.xlSheetHidden;
                                workbook.Sheets[2].visible = Excel.XlSheetVisibility.xlSheetHidden;
                                workbook.Sheets[3].Visible = Excel.XlSheetVisibility.xlSheetVisible;
                                worksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlPortrait;
                            }

                            worksheet.PageSetup.Zoom = false;
                            worksheet.PageSetup.FitToPagesWide = 1;
                            worksheet.PageSetup.FitToPagesTall = 1;

                            // Yönlendirme kontrolü (Hem PDF hem yazdırma için geçerli)
                            if (YazdirilacakBelge != "Aylik_Gunluk")
                            {
                                worksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlLandscape;
                            }
                            else
                            {
                                worksheet.PageSetup.Orientation = Excel.XlPageOrientation.xlPortrait;
                            }

                            if (selectedPrinter == "PDF")
                            {
                                // PDF işlemleri...
                                string pdfDosyaYolu = System.IO.Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), $"{YazdirilacakBelge}.pdf");

                                workbook.ExportAsFixedFormat(
                                    Excel.XlFixedFormatType.xlTypePDF,
                                    pdfDosyaYolu,
                                    Excel.XlFixedFormatQuality.xlQualityStandard
                                );
                                DialogResult result = MessageBox.Show($"PDF dosyası başarıyla oluşturuldu:\n{pdfDosyaYolu}\n\nDosyayı açmak ister misiniz?",
                                                                  "Başarılı",
                                                                  MessageBoxButtons.YesNoCancel,
                                                                  MessageBoxIcon.Information);

                                if (result == DialogResult.Yes)
                                {
                                    System.Diagnostics.Process.Start(pdfDosyaYolu);
                                }
                                else if (result == DialogResult.No)
                                {
                                    string folderPath = System.IO.Path.GetDirectoryName(pdfDosyaYolu);
                                    System.Diagnostics.Process.Start("explorer.exe", folderPath);
                                }
                            }
                            else
                            {
                                for (int i = 1; i <= numericUpDown1.Value; i++)
                                {
                                    try
                                    {
                                        if (YazdirilacakBelge != "Aylik_Gunluk")
                                        {
                                            // Sayfa düzenini yatay yap
                                            worksheet.PageSetup.Orientation = Microsoft.Office.Interop.Excel.XlPageOrientation.xlLandscape;
                                        }
                                        worksheet.PrintOutEx();
                                        MessageBox.Show("Yazdırma işlemi başarıyla tamamlandı.", "Başarılı", MessageBoxButtons.OK, MessageBoxIcon.Information);
                                    }
                                    catch (Exception ex)
                                    {
                                        MessageBox.Show("Yazdırma sırasında bir hata ile karşılaşıldı : " + ex.Message, "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                                        throw;
                                    }
                                }
                            }
                            workbook.Sheets[1].Visible = Excel.XlSheetVisibility.xlSheetVisible;
                            workbook.Sheets[2].Visible = Excel.XlSheetVisibility.xlSheetVisible;
                            workbook.Sheets[3].Visible = Excel.XlSheetVisibility.xlSheetVisible;
                        }
                        catch (Exception ex)
                        {
                            MessageBox.Show($"Bir hata oluştu: {ex.Message}", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                        }
                        finally
                        {
                            // Kaynakları temizle
                            if (worksheet != null)
                            {
                                Marshal.ReleaseComObject(worksheet);
                                worksheet = null;
                            }
                            if (workbook != null)
                            {
                                try
                                {
                                    workbook.Close(false);
                                    Marshal.ReleaseComObject(workbook);
                                }
                                catch { } // Hata oluşursa sessizce devam et
                                workbook = null;
                            }
                            if (excelApp != null)
                            {
                                try
                                {
                                    excelApp.Quit();
                                    Marshal.ReleaseComObject(excelApp);
                                }
                                catch { } // Hata oluşursa sessizce devam et
                                excelApp = null;
                            }

                            // Excel işlemlerini zorla kapatma
                            try
                            {
                                Process[] processes = Process.GetProcessesByName("EXCEL");
                                foreach (Process proc in processes)
                                {
                                    if (!proc.HasExited)
                                    {
                                        proc.Kill();
                                    }
                                }
                            }
                            catch (Exception ex)
                            {
                                MessageBox.Show("EXCEL'İ KAPATIRKEN BİR HATA İLE KARŞILAŞILDI : " + ex.Message, "HATA", MessageBoxButtons.OK, MessageBoxIcon.Error);
                            }

                            GC.Collect();
                            GC.WaitForPendingFinalizers();
                        }
                    }
                }
            }
        }

