        public void OgrenciDetaylariClick(int id)
        {
            OGRtabControl1.Visible = false;
            OGRTtabControl1.Visible = false;
            ISLETMEtabControl1.Visible = false;
            SETTINGStabControl1.Visible = false;
            YAZDIRtabControl1.Visible = false;
            OgrenciDETAYtabControl1.Visible = true;
            OgretmenDETAYtabControl1.Visible = false;
            IsletmeDETAYtabControl1.Visible = false;

            OgrenciDetayOgrenciID = id;

            var ogrenci = (from i in ConnectToDatabase.OgrenciTablo where i.id == id select i).FirstOrDefault();
            OgrenciDetaylariniKopyala(ogrenci.OgrenciAd, ogrenci.OgrenciSoyad, ogrenci.OgrenciOkulNo, ogrenci.OgrenciSinif, ogrenci.OgrenciTCKimlikNo, ogrenci.OgreciTelNo,
                ogrenci.OgrenciAlanAdi, ogrenci.OgrenciDalAdi, ogrenci.OgrenciStajaBaslangicTarihi.ToString(), ogrenci.OgrenciStajBitistarihi.ToString(), ogrenci.OgrencininFirmaAdi,
                ogrenci.OgrenciKoordinatorOgretmeni, ogrenci.OgrenciGrup, ogrenci.OgrenciStajDonemi);
            // Label'lara kısaltılmış metin atama
            infoOgrenciAd_label.Text = KisaMetin(ogrenci.OgrenciAd, 35);
            infoOgrenciSoyad_label.Text = KisaMetin(ogrenci.OgrenciSoyad, 35);
            infoOgrenciNo_label.Text = KisaMetin(ogrenci.OgrenciOkulNo, 35);
            infoOgrenciSinifi_label.Text = KisaMetin(ogrenci.OgrenciSinif, 35);
            infoOgrenciTC_label.Text = KisaMetin(ogrenci.OgrenciTCKimlikNo, 35);
            infoOgrenciTelNo_label.Text = KisaMetin(ogrenci.OgreciTelNo, 35);
            infoOgrenciAlanAdi_label.Text = KisaMetin(ogrenci.OgrenciAlanAdi, 35);
            infoOgrenciDalAdi_label.Text = KisaMetin(ogrenci.OgrenciDalAdi, 35);
            infoOgrenciStajBaslangicTarihi_label.Text = ogrenci.OgrenciStajaBaslangicTarihi.ToString("dd.MM.yyyy");
            infoOgrenciStajBitisTarihi_label.Text = ogrenci.OgrenciStajBitistarihi.ToString("dd.MM.yyyy");
            infoOgrenciFirmaAdi_label.Text = KisaMetin(ogrenci.OgrencininFirmaAdi, 35);
            infoOgrenciKoordinatorOgretmen_label.Text = KisaMetin(ogrenci.OgrenciKoordinatorOgretmeni, 35);
            infoOgrenciGrubu_label.Text = KisaMetin(ogrenci.OgrenciGrup + " Grubu, " + ogrenci.OgrenciStajDonemi, 35);
            ogrenciDetayxHakkindaBaziBilgiler_label.Text = $"{ogrenci.OgrenciAd.Split(' ')[0]} hakkında bazı bilgiler";

            // Aynı sınıftaki öğrencilerin ad ve soyadlarını listeleme
            var AyniSiniftakiOgrencilerinAdlariVeSoyadlari = (from i in ConnectToDatabase.OgrenciTablo
                                                              where i.OgrenciSinif == ogrenci.OgrenciSinif
                                                              select new
                                                              {
                                                                  Ad = i.OgrenciAd,
                                                                  Soyad = i.OgrenciSoyad,
                                                                  OkulNo = i.OgrenciOkulNo
                                                              }).ToList();

            ogrenciDetayDataGridView1.Columns.Clear();
            ogrenciDetayDataGridView1.DataSource = AyniSiniftakiOgrencilerinAdlariVeSoyadlari;

            // Sütun başlıklarını özelleştirme
            ogrenciDetayDataGridView1.Columns[0].HeaderText = "Ad";
            ogrenciDetayDataGridView1.Columns[1].HeaderText = "Soyad";
            ogrenciDetayDataGridView1.Columns[2].HeaderText = "OkulNo";
        }

