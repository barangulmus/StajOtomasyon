        private bool isDeleting = false;

        private void AutoCompleteWithHighlight(ComboBox combo, string currentText)
        {
            if (isDeleting) return;

            if (string.IsNullOrEmpty(currentText))
            {
                combo.Text = string.Empty;
                return;
            }

            // Find the first item that contains the current text (case-insensitive)
            string matchingItem = combo.Items.Cast<object>()
                                      .Select(item => item.ToString())
                                      .FirstOrDefault(item => item.IndexOf(currentText, StringComparison.OrdinalIgnoreCase) >= 0);

            if (matchingItem != null)
            {
                int cursorPosition = combo.SelectionStart;
                string userTypedPart = currentText.Substring(0, cursorPosition);

                // Check if the matching item starts with the user-typed part (case-insensitive)
                if (matchingItem.StartsWith(userTypedPart, StringComparison.OrdinalIgnoreCase))
                {
                    combo.Text = matchingItem; // Set the text to the matching item
                    combo.SelectionStart = cursorPosition;
                    combo.SelectionLength = matchingItem.Length - cursorPosition;
                }
            }
            else
            {
                combo.Text = currentText;
                combo.SelectionStart = currentText.Length;
            }
        }
        #region Comboboxta otomatik tamamlama işlemleri
        // KeyDown işlemi için genel metot
        private void HandleComboBoxKeyDown(object sender, KeyEventArgs e)
        {
            ComboBox combo = (ComboBox)sender;

            if (e.KeyCode == Keys.Back || e.KeyCode == Keys.Delete)
            {
                isDeleting = true;

                int selectionStart = combo.SelectionStart;
                int selectionLength = combo.SelectionLength;
                string currentText = combo.Text;

                if (selectionLength > 0)
                {
                    // Seçili kısmı sil
                    combo.Text = currentText.Remove(selectionStart, selectionLength);
                    combo.SelectionStart = selectionStart;
                }
                else if (e.KeyCode == Keys.Back && selectionStart > 0)
                {
                    // Backspace ile silme
                    combo.Text = currentText.Remove(selectionStart - 1, 1);
                    combo.SelectionStart = selectionStart - 1;
                }
                else if (e.KeyCode == Keys.Delete && selectionStart < currentText.Length)
                {
                    // Delete ile silme
                    combo.Text = currentText.Remove(selectionStart, 1);
                    combo.SelectionStart = selectionStart;
                }

                e.Handled = true;
                isDeleting = false;
            }
        }
