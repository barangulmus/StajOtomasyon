        private void ListeyiFormatla()
        {
            var hedef = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();

            if (hedef == null)
            {
                MessageBox.Show("Veritabanında kayıt bulunamadı!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            if (settingsAlanlarVeDallariList_listbox != null)
            {
                settingsAlanlarVeDallariList_listbox.Items.Clear();

                if (hedef.AlanAdlari != null && hedef.AlanaAitDalAdlari != null)
                {
                    // Alan adlarını ve dal adlarını ayırma
                    var alanAdlariList = hedef.AlanAdlari.Trim('{', '}').Split(',');
                    var dalAdlariList = hedef.AlanaAitDalAdlari.Trim('{', '}').Split(',');

                    foreach (var alan in alanAdlariList)
                    {
                        // Alan adını ekle
                        string temizAlanAdi = alan.Trim('\'', ' ').Trim();
                        settingsAlanlarVeDallariList_listbox.Items.Add(temizAlanAdi);

                        // Alanla ilişkili dal adlarını ekle
                        foreach (var dal in dalAdlariList)
                        {
                            // Eğer dal adı "Alan Adı-/-Dal Adı" formatındaysa ve alan adıyla eşleşiyorsa
                            if (dal.Contains("-/-"))
                            {
                                var parcalar = dal.Split(new[] { "-/-" }, StringSplitOptions.None);
                                if (parcalar.Length == 2 && parcalar[0].Trim('\'', ' ') == temizAlanAdi)
                                {
                                    string sadeceDalAdi = parcalar[1].Trim('\'', ' ').Trim();
                                    settingsAlanlarVeDallariList_listbox.Items.Add("\t" + sadeceDalAdi); // Tab ekleyerek altına dal adı ekle
                                }
                            }
                        }
                    }
                }
                else
                {
                    MessageBox.Show("Alanlar veya dallar bulunamadı!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
            }
            else
            {
                MessageBox.Show("ListBox bileşeni bulunamadı. Formdaki bileşenleri kontrol edin.");
            }
        }
        private void SiniflariListele()
        {
            try
            {
                // ListBox kontrolü
                if (settingsSiniflarList_listbox == null)
                {
                    MessageBox.Show("Hata: Sınıflar Listesi bileşeni (ListBox) bulunamadı.", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }
                // Veritabanından settings tablosundaki ilk kaydı al
                var hedef = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();

                // Eğer hedef veya SinifAdlari kolon verisi null ise
                if (hedef == null || string.IsNullOrEmpty(hedef.SinifAdlari))
                {
                    return;
                }

                // Düz string verisini temizleyip listeye dönüştür
                string sinifAdlariVerisi = hedef.SinifAdlari; // Örneğin: "{'AMP12A_E (TES)','AMP12B_E (HAB)'}"
                sinifAdlariVerisi = sinifAdlariVerisi.Trim('{', '}'); // İlk ve son süslü parantezi kaldır
                var siniflar = sinifAdlariVerisi.Split(',') // Virgülle ayır
                                               .Select(s => s.Trim('\'', ' ')) // Tek tırnak ve boşlukları temizle
                                               .ToList();

                // ListBox'u temizle ve sınıfları ekle
                settingsSiniflarList_listbox.Items.Clear();
                addOgrenciSinifi_combo.Items.Clear();
                upOgrenciSinifi_combo.Items.Clear();
                foreach (var sinif in siniflar)
                {
                    settingsSiniflarList_listbox.Items.Add(sinif);
                    addOgrenciSinifi_combo.Items.Add(sinif);
                    upOgrenciSinifi_combo.Items.Add(sinif);
                }
            }
            catch (Exception ex)
            {
                // Hata yönetimi
                MessageBox.Show($"Bir hata oluştu: {ex.Message}", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
        public void AlanDalAdlariMethod()
        {
            var hedef = (from i in ConnectToDatabase.SettingsTablo
                         select i).FirstOrDefault();
            // Alan adlarını ayıkla
            var alanAdlari = hedef.AlanAdlari
                .Trim('{', '}') // Küme parantezlerini temizle
                .Split(',') // Virgüle göre ayır
                .Select(alan => alan.Trim('\'', ' ')) // Tek tırnakları ve boşlukları temizle
                .ToList();

            // Dal adlarını ayıkla ve gruplandır
            var dalAdlari = hedef.AlanaAitDalAdlari
                .Trim('{', '}') // Küme parantezlerini temizle
                .Split(',') // Virgüle göre ayır
                .Select(dal => dal.Trim('\'', ' ')) // Tek tırnakları ve boşlukları temizle
                .ToList();

            // Alan-dal eşlemesi oluştur
            grupluAlanDal = new Dictionary<string, List<string>>();
            foreach (var alan in alanAdlari)
            {
                grupluAlanDal[alan] = dalAdlari
                    .Where(dal => dal.StartsWith(alan + "-/-")) // Alan adına göre filtrele
                    .Select(dal => dal.Split(new[] { "-/-" }, StringSplitOptions.None)[1]) // Dal adını al
                    .ToList();
            }

            // Alan adlarını ComboBox'a yükle
            addOgrenciAlanAdi_txt.Items.Clear();
            upOgrenciAlanAdi_txt.Items.Clear();
            addOgretmenAlanAdı_combo.Items.Clear();
            upOgretmenAlanAdi_combo.Items.Clear();
            addBolum_combo.Items.Clear();
            addDal_combo.Items.Clear();
            ogretmenListAlanAdlari_combobox.Items.Clear();
            IsletmeListAlanAdlari_combobox.Items.Clear();
            foreach (var alan in grupluAlanDal.Keys)
            {
                addOgrenciAlanAdi_txt.Items.Add(alan);
                upOgrenciAlanAdi_txt.Items.Add(alan);
                addOgretmenAlanAdı_combo.Items.Add(alan);
                upOgretmenAlanAdi_combo.Items.Add(alan);
                addBolum_combo.Items.Add(alan);
                addDal_combo.Items.Add(alan);
                ogretmenListAlanAdlari_combobox.Items.Add(alan);
                IsletmeListAlanAdlari_combobox.Items.Add(alan);
            }
        }
