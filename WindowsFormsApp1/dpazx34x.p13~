            // İlk ve ikinci yılı ilgili textbox'lara atama
            if (yillar[0] != null && yillar[1] != null)
            {
                EgitimOgretimYili1_textbox.Text = yillar[0].Trim(); // İlk yılı al ve boşlukları temizle
