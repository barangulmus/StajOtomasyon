        private void settingsTumunuSıfırlaButon_button_Click(object sender, EventArgs e)
        {
            var kontrol = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
            if (MessageBox.Show("Tüm zorunlu ayarlar silinecek. Bu işlemi geri alamazsınız. Eğer küçük değişiklikler yapmak istiyorsanız 'düzenle' butonuna tıklayarak değişikliklerinizi yapabilirsiniz. \nOnaylıyor musunuz?", "Uyarı", MessageBoxButtons.YesNo) == DialogResult.Yes)
            {
                kontrol.id = 1;
                kontrol.OkulAdi = "";
                kontrol.AlanAdlari = "";
                kontrol.AlanaAitDalAdlari = "";
                kontrol.SinifAdlari = "";
                kontrol.FirmIslemleriSayfasındaListelenecekIller = "Tüm İller";
                kontrol.VarsayilanStajaBaslangicTarihi = DateTime.Now;
                kontrol.VarsayilanStajBitisTarihi = DateTime.Now;
                kontrol.MudurYardimcisiAdi = "";
                try
                {
                    ConnectToDatabase.SaveChanges();
                    MessageBox.Show("Ayarlar sıfırlandı!");
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Ayarlar sıfırlanırken bir hata ile karşılaşıldı\n{ex}");
                    throw;
                }

                settingsOkulAdi_textbox.Text = kontrol.OkulAdi;
                settingsAlanAdi_textbox.Text = null;
                settingsAlanaAitDalAdi_textbox.Text = null;
                settingsSinifAdi_textbox.Text = null;
                if (kontrol.FirmIslemleriSayfasındaListelenecekIller == "Tüm İller")
                {
                    settingsTumIller_radio.Checked = true;
                }
                else
                {
                    settingsOzelIller_radio.Checked = true;
                }
                settingsVarsayilanStajaBaslamaTarihi_datetimepicker.Value = kontrol.VarsayilanStajaBaslangicTarihi;
                settingsVarsayilanStajBitisTarihi_datetimepicker.Value = kontrol.VarsayilanStajBitisTarihi;
            }
            else
            {
                MessageBox.Show("Silme işlemi iptal edildi!");
            }
        }

