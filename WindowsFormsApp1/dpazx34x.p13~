        public void IslemSonrasiSayfaDuzeni()
        {
            var OgrenciList = (from i in ConnectToDatabase.OgrenciTablo orderby i.OgrenciAd ascending select i).ToList();
            var OgretmenList = (from i in ConnectToDatabase.OgretmenTablo orderby i.OgretmenAd ascending select i).ToList();
            var IsletmeList = (from i in ConnectToDatabase.IsletmeTablo orderby i.IsletmeAd ascending select i).ToList();
            if (OgrenciList.Count > 0)
            {
                ogrenciListDatagridView.DataSource = OgrenciList;
            }
            if (OgretmenList.Count > 0)
            {
                ogretmenListDatagridView.DataSource = OgretmenList;
            }
            if (IsletmeList.Count > 0)
            {
                IsletmeListDatagridView.DataSource = IsletmeList;
            }

            addOgrenciKordinatorOgretmen_combo.Items.Clear();
            addOgrenciFirmaAdi_combo.Items.Clear();
            upOgrenciKordinatorOgretmen_combo.Items.Clear();
            upOgrenciFirmaAdi_combo.Items.Clear();
            updateOgretmenAdSoyad_combo.Items.Clear();
            updateIsletmeAdi_combo.Items.Clear();
            upIl_combo.Items.Clear();
            upIlce_combo.Items.Clear();


            deleteOgrenciNo_txt.Text = string.Empty;

            deleteOgretmenAdSoyad_combo.Items.Clear();

            deleteIsletmeAdi_combo.Items.Clear();


            IsletmeIsimleriListeleMethod();
            OgretmenIsimleriListeleMethod();
            var settings = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
            if (settings.FirmIslemleriSayfasındaListelenecekIller == "Tüm İller")
            {
                addIl_combo.Items.AddRange(illerVeIlceler.Keys.ToArray());
                upIl_combo.Items.AddRange(illerVeIlceler.Keys.ToArray());
                settingsIllerList_listbox.Items.Clear(); // Önce listeyi temizleyin
                foreach (var il in illerVeIlceler.Keys)
                {
                    settingsIllerList_listbox.Items.Add(il);
                }
            }
            else if (settings.FirmIslemleriSayfasındaListelenecekIller != "Tüm İller")
            {
                // Sadece veritabanında yer alan illeri listele
                var mevcutIller = new List<string>();

                if (!string.IsNullOrEmpty(settings.FirmIslemleriSayfasındaListelenecekIller))
                {
                    mevcutIller = settings.FirmIslemleriSayfasındaListelenecekIller
                        .Trim('{', '}') // Süslü parantezleri temizle
                        .Split(',')
                        .Select(il => il.Trim('\'', ' ')) // Tırnak işaretlerini ve boşlukları temizle
                        .ToList();
                }

                // addIl_combo ve upIl_combo bileşenlerini temizle
                addIl_combo.Items.Clear();
                upIl_combo.Items.Clear();

                // Mevcut illeri ekle
                addIl_combo.Items.AddRange(mevcutIller.ToArray());
                upIl_combo.Items.AddRange(mevcutIller.ToArray());
                settingsIllerList_listbox.Items.Clear(); // Önce listeyi temizleyin
                foreach (var il in mevcutIller)
                {
                    settingsIllerList_listbox.Items.Add(il);
                }
            }

            //Güncelle kısımlarının girişlerini kapat.
            updateOgrenciPanelSol_panel.Enabled = false;
            updateOgretmenPanelSol_panel.Enabled = false;
            updateIsletmePanelSol_panel.Enabled = false;

            upOgrenciGuncelle_button.Enabled = false;
            upOgretmenGuncelle_button.Enabled = false;
            upIsletmeGuncelle_button.Enabled = false;

            if ((from i in ConnectToDatabase.OgrenciTablo select i).ToList().Count() != 0)
            {
                addOgrenciTemizle();
                upOgrenciTemizle();
            }
            if ((from i in ConnectToDatabase.OgretmenTablo select i).ToList().Count() != 0)
            {
                addOgretmenTemizle();
                upOgretmenTemizle();
            }
            if ((from i in ConnectToDatabase.IsletmeTablo select i).ToList().Count() != 0)
            {
                addIsletmeTemizle();
                upIsletmeTemizle();
            }
        }
        public bool ComboBoxKontrol(ComboBox comboBox, string hataMesaji)
        {
            // Büyük/küçük harf duyarlılığı OLMADAN kontrol
            bool degerVarMi = comboBox.Items.Cast<string>()
                                  .Any(item => item.Equals(comboBox.Text, StringComparison.OrdinalIgnoreCase));

            if (!degerVarMi)
            {
                MessageBox.Show(hataMesaji, "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                comboBox.Focus(); // Kullanıcıya hangi ComboBox'ta hata olduğunu göster
                return false;
            }
            return true;
        }
