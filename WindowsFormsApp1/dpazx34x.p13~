                !ComboBoxKontrol(upOgrenciFirmaAdi_combo, "Lütfen geçerli bir firma seçin!") ||
                !ComboBoxKontrol(upOgrenciAlanAdi_txt, "Lütfen geçerli bir alan adı seçin!"))
            {
                return;
            }

            // 2. RadioButton Grup Kontrolleri
            if (!upOgrGrupA_radio.Checked && !upOgrGrupB_radio.Checked &&
                !upOgrGrupC_radio.Checked && !upOgrGrupD_radio.Checked)
            {
                MessageBox.Show("Lütfen öğrenci grubu seçiniz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // 3. Staj Dönemi Kontrolü
            if (!upOgrenciStajDonemiKis_radio.Checked &&
                !upOgrenciStajDonemiYaz_radio.Checked &&
                !upOgrenciStajDonemiMesem_radio.Checked)
            {
                MessageBox.Show("Lütfen staj dönemi seçiniz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // 4. Tarih Mantıksal Kontrol
            if (upOgrenciStajBaslangic_datetime.Value > upOgrenciStajBitis_datetime.Value)
            {
                MessageBox.Show("Başlangıç tarihi bitiş tarihinden sonra olamaz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            string GuncellenecekOgrencininNosu = updateOgrenciNo_txt.Text;
            var hedef = ConnectToDatabase.OgrenciTablo
                        .FirstOrDefault(i => i.OgrenciOkulNo == GuncellenecekOgrencininNosu);

            if (hedef == null)
            {
                MessageBox.Show("Girdiğiniz okul numarasına sahip öğrenci bulunamadı.", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            try
            {
                // 5. Null Safe Atamalar
                hedef.OgrenciAd = upOgrenciAdi_txt.Text;
                hedef.OgrenciSoyad = upOgrenciSoyadi_txt.Text;
                hedef.OgrenciOkulNo = upOgrenciNo_txt.Text;
                hedef.OgrenciSinif = upOgrenciSinifi_combo.SelectedItem?.ToString() ?? "";
                hedef.OgrenciTCKimlikNo = upOgrenciTc_txt.Text;
                hedef.OgreciTelNo = upOgrenciTelNo_txt.Text;
                hedef.OgrenciAlanAdi = upOgrenciAlanAdi_txt.SelectedItem?.ToString() ?? "";
                hedef.OgrenciDalAdi = upOgrenciDalAdi_combo.SelectedItem?.ToString() ?? "";

                // 6. RadioButton Atamaları
                hedef.OgrenciGrup = upOgrGrupA_radio.Checked ? "A" :
                                   upOgrGrupB_radio.Checked ? "B" :
                                   upOgrGrupC_radio.Checked ? "C" : "D";

                hedef.OgrenciStajDonemi = upOgrenciStajDonemiKis_radio.Checked ? "Kış" :
                                         upOgrenciStajDonemiYaz_radio.Checked ? "Yaz" : "MESEM";

                // 7. Tarih Atamaları
                hedef.OgrenciStajaBaslangicTarihi = upOgrenciStajBaslangic_datetime.Value;
                hedef.OgrenciStajBitistarihi = upOgrenciStajBitis_datetime.Value;

                // 8. ComboBox Atamaları
                hedef.OgrenciKoordinatorOgretmeni = upOgrenciKordinatorOgretmen_combo.SelectedItem?.ToString() ?? "";
                hedef.OgrencininFirmaAdi = upOgrenciFirmaAdi_combo.SelectedItem?.ToString() ?? "";

                // 9. Veritabanı Güncelleme
                ConnectToDatabase.SaveChanges();
                MessageBox.Show("Öğrenci bilgileri başarıyla güncellendi.", "Başarılı", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (DbUpdateException ex)
            {
                MessageBox.Show($"Veritabanı güncelleme hatası:\n{ex.InnerException?.Message}", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Beklenmeyen hata:\n{ex.Message}", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                IslemSonrasiSayfaDuzeni();
                upOgrenciTemizle();
            }
