        private void FormatPhoneNumber(object sender, EventArgs e)
        {
            // TextBox'tan girdi al
            TextBox textBox = sender as TextBox;
            string input = textBox.Text;

            // Eğer boşsa, hiç formatlama yapma
            if (string.IsNullOrEmpty(input)) return;

            // Sadece rakamları al
            string digits = new string(input.Where(char.IsDigit).ToArray());

            // Maksimum 10 karakter girmeye izin ver
            if (digits.Length > 10)
                digits = digits.Substring(0, 10);

            // Telefon numarasını formatla
            string formattedNumber = string.Empty;

            // Formatlı numarayı oluştur
            if (digits.Length > 0)
                formattedNumber = "(" + digits.Substring(0, Math.Min(3, digits.Length)) + ")";
            if (digits.Length > 3)
                formattedNumber += " " + digits.Substring(3, Math.Min(3, digits.Length - 3));
            if (digits.Length > 6)
                formattedNumber += " " + digits.Substring(6, Math.Min(2, digits.Length - 6));
            if (digits.Length > 8)
                formattedNumber += " " + digits.Substring(8, digits.Length - 8);

            // Eğer format değiştiyse, TextBox'ı güncelle
            if (formattedNumber != textBox.Text)
            {
                // Kullanıcının imleç pozisyonunu kaydet
                int cursorPos = textBox.SelectionStart;

                // TextBox'ı güncelle
                textBox.Text = formattedNumber;

                // İmleci yeni pozisyona yerleştir
                int newCursorPos = cursorPos;

                // Formatlama sonrası imleç kaymasını engellemek için
                if (cursorPos <= 3) // Parantez kısmı
                    newCursorPos = cursorPos + 1;
                else if (cursorPos > 3 && cursorPos <= 7) // İlk boşluk
                    newCursorPos = cursorPos + 2;
                else if (cursorPos > 7 && cursorPos <= 11) // İkinci boşluk
                    newCursorPos = cursorPos + 3;
                else if (cursorPos > 11) // Son kısım
                    newCursorPos = cursorPos + (formattedNumber.Length - input.Length);

                // İmleci yeni pozisyona yerleştir
                textBox.SelectionStart = newCursorPos;
            }
        }
