        //Alan Adı Ekle Button
        private void settingsAlanAdiEkleButon_button_Click(object sender, EventArgs e)
        {
            var hedef = (from i in ConnectToDatabase.SettingsTablo select i).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(settingsAlanAdi_textbox.Text))
            {
                string yeniAlan = settingsAlanAdi_textbox.Text;
                if (!hedef.AlanAdlari.Contains($"'{yeniAlan}'"))
                {
                    if (string.IsNullOrEmpty(hedef.AlanAdlari))
                        hedef.AlanAdlari = $"{{'{yeniAlan}'}}";
                    else
                        hedef.AlanAdlari = hedef.AlanAdlari.TrimEnd('}') + $",'{yeniAlan}'}}";

                    settingsAlanlarVeDallariList_listbox.Items.Add(yeniAlan);
                    ConnectToDatabase.SaveChanges();
                    settingsDegisiklikYapiildimi = true;
                    MessageBox.Show($"Alan adı başarıyla eklendi.");
                }
                else
                {
                    MessageBox.Show("Bu alan zaten mevcut!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                }
                IslemSonrasiSayfaDuzeni();
            }
            else
            {
                MessageBox.Show("Alan adı boş bırakılamaz!", "Hata", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

