                    csSettinsClass.MudurYardimcisiAdi = "";
                    csSettinsClass.KoordinatorMuduryardimcisiIsmi = "";
                    csSettinsClass.okulMuduruIsmi = "";
                    DateTime bugun = DateTime.Today;
                    int yil = bugun.Year;
                    int ay = bugun.Month;
                    string egitimOgretimYili;

                    if (ay >= 9) // Eylül (9) veya sonrası
                    {
                        egitimOgretimYili = $"{yil} - {yil + 1}";
                    }
                    else // Ocak (1) ile Ağustos (8) arası
                    {
                        egitimOgretimYili = $"{yil - 1} - {yil}";
                    }

                    csSettinsClass.EgitimOgretimYili = egitimOgretimYili;

                    ConnectToDatabase.SettingsTablo.Add(csSettinsClass);
                    ConnectToDatabase.SaveChanges();
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Ayarlar sayfasında ayar bulunamadığından varsayılan olarak atadığımız veriler veritabanına işlenemedi. Hata Mesajı \n{ex}");
                    throw;
                }
            }
